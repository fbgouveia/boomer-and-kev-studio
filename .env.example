# Boomer & Kev Studio - Environment Variables

# Studio access (required in production)
STUDIO_AUTH_USER=
STUDIO_AUTH_PASSWORD=
N8N_RADAR_SECRET=
CRON_SECRET=

# AI Service Keys (Replaces localStorage for security)
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5
HF_CREDENTIALS=

# Higgsfield (API direta, backend only — decisao 08/11/2026)
# HF_API_KEY = valor completo copiado do console. SERVER-ONLY: nunca no browser,
# logs, jobs ou respostas. Deixe em branco ate a raiz ativar a configuracao.
HF_API_KEY=
# VIDEO_PROVIDER: vazio/replicate = Replicate (legado, comportamento inalterado);
# higgsfield = API direta https://api.higgsfield.ai. Valor invalido e rejeitado
# (sem fallback silencioso que duplicaria gasto pago).
VIDEO_PROVIDER=
# Modelo Higgsfield confirmado para esta fase (contrato em architecture/higgsfield-api.md).
HIGGSFIELD_MODEL=kling-video/v3.0/pro/image-to-video
# Teto ACUMULADO dos testes iniciais em USD (padrão 30 — decisao do Felipe).
# A reserva vive em disco (.tmp/budget_*.json) e vale entre jobs, reinicios e
# processos; submissao incerta NUNCA libera verba.
HIGGSFIELD_INITIAL_TEST_CAP_USD=30

# Supabase (active persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Social APIs (Future use)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Desenvolvimento: 1 = sem REPLICATE_API_TOKEN, o pipeline usa os vídeos piloto
# (../00_Legacy_Archives/Piloto). Nunca em produção.
STUDIO_SANDBOX=
