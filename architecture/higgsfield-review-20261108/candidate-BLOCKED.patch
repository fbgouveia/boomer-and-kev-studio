+        const client = new HiggsfieldClient({ apiKey: API_KEY, fetchImpl: impl });
+        const outcome = await client.getStatus(`${OFFICIAL}/v1/requests/r`);
+        assert.deepEqual(outcome, { kind: 'succeeded', outputUrl: 'https://cdn.hf.example/v.mp4' });
