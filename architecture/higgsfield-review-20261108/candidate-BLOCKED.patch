new file mode 100644
index 0000000..fc2f9aa
--- /dev/null
+++ b/src/lib/cost-ledger.ts
@@ -0,0 +1,358 @@
+// Ledger durável do teto global dos testes iniciais Higgsfield (US$30 acumulados,
+// não por job). Tudo em micros USD inteiros, persistido em disco e compartilhado
+// entre jobs/processos/reinícios.
+//
+// Design lock-free: a reserva é criada ATOMICAMENTE (link exclusivo) ANTES da soma
+// de verificação. Quem chega depois enxerga as reservas anteriores e aborta se o
+// teto estourar — corridas entre processos podem rejeitar a mais (conservador),
+// jamais gastar a mais. Reserva sem resultado conhecido permanece retida:
+// submissão incerta nunca libera verba por suposição.
+
+import crypto from 'node:crypto';
+import { existsSync, mkdirSync, readdirSync, readFileSync, unlinkSync, writeFileSync, linkSync, renameSync } from 'node:fs';
+import path from 'node:path';
+import { parseUsdToMicros, MICRO_PER_USD } from '@/lib/money';
+
+export { MICRO_PER_USD };
+
+const RELEASED_RETENTION_MS = 7 * 24 * 60 * 60_000;
+
+// Liberação SÓ com contrato documentado de não-cobrança:
+// - submission_rejected_no_generation: o provedor recusou o pedido (4xx) — nenhuma
+//   geração foi criada, logo nada pode ser cobrado.
+// - provider_terminal_no_charge: término confirmado failed/nsfw/canceled no
+//   contrato do provedor (cobre na conclusão, não no fracasso terminal).
+// Estados desconhecidos/ambíguos NUNCA liberam — a reserva fica retida.
+export type ReleaseReason = 'submission_rejected_no_generation' | 'provider_terminal_no_charge';
+
+const RELEASE_REASONS: readonly ReleaseReason[] = [
+    'submission_rejected_no_generation',
+    'provider_terminal_no_charge',
+];
+
+type LedgerState = 'RESERVED' | 'CHARGED' | 'RELEASED';
+
+type LedgerRecord = {
+    key: string;
+    amountMicros: number;
+    payloadHash: string;
+    state: LedgerState;
+    jobId?: string;
+    sceneId?: string;
+    releaseReason?: string;
+    createdAt: string;
+    updatedAt: string;
+};
+
+export type CostReservation = {
+    operationKey: string;
+    filePath: string;
+    amountMicros: number;
+};
+
+export type ReserveOutcome =
+    | { kind: 'reserved'; reservation: CostReservation }
+    // Mesma chave + mesmo payload: idempotente, NUNCA reserva duas vezes.
+    | { kind: 'existing'; reservation: CostReservation }
+    | { kind: 'conflict'; reason: 'PAYLOAD_MISMATCH' | 'KEY_RELEASED_USE_NEW_ATTEMPT' }
+    | { kind: 'budget_exceeded'; requestedMicros: number; committedMicros: number; capMicros: number }
+    | { kind: 'ledger_corrupt'; filePath: string };
+
+export type ChargeOutcome =
+    | { kind: 'charged' }
+    | { kind: 'already_charged' }
+    | { kind: 'unknown_key' }
+    | { kind: 'conflict'; state: string };
+
+export type ReleaseOutcome =
+    | { kind: 'released' }
+    | { kind: 'already_released' }
+    | { kind: 'unknown_key' }
+    | { kind: 'charged_cannot_release' }
+    | { kind: 'conflict'; state: string };
+
+export type BudgetSummary = {
+    capMicros: number;
+    reservedMicros: number;
+    chargedMicros: number;
+    remainingMicros: number;
+    corruptEntries: string[];
+};
+
+function reservationPath(ledgerDir: string, operationKey: string): string {
+    const digest = crypto.createHash('sha256').update(operationKey).digest('hex');
+    return path.join(ledgerDir, `budget_${digest}.json`);
+}
+
+function readRecord(filePath: string): { ok: true; record: LedgerRecord } | { ok: false } {
+    try {
+        const record = JSON.parse(readFileSync(filePath, 'utf8')) as LedgerRecord;
+        if (
+            typeof record?.key !== 'string'
+            || typeof record?.amountMicros !== 'number'
+            || typeof record?.state !== 'string'
+            || typeof record?.payloadHash !== 'string'
+        ) {
+            return { ok: false };
+        }
+        return { ok: true, record };
+    } catch {
+        return { ok: false };
+    }
+}
+
+// Substituição atômica de registro existente (RESERVED → CHARGED/RELEASED).
+function writeRecordAtomic(filePath: string, record: LedgerRecord): void {
+    const tempPath = `${filePath}.tmp.${process.pid}.${crypto.randomUUID()}`;
+    writeFileSync(tempPath, JSON.stringify(record, null, 2), { flag: 'wx' });
+    try {
+        renameSync(tempPath, filePath);
+    } finally {
+        try { unlinkSync(tempPath); } catch { /* rename moveu; nada a limpar */ }
+    }
+}
+
+// Criação exclusiva: write em temporário + link. Se o destino já existe (EEXIST),
+// outro processo venceu a corrida pela MESMA chave — o perdedor adota o registro
+// existente. Leitores nunca veem arquivo parcial.
+function createReservationAtomically(filePath: string, record: LedgerRecord): boolean {
+    const tempPath = `${filePath}.tmp.${process.pid}.${crypto.randomUUID()}`;
+    try {
+        writeFileSync(tempPath, JSON.stringify(record, null, 2), { flag: 'wx' });
+        try {
+            linkSync(tempPath, filePath);
+            return true;
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code === 'EEXIST') return false;
+            throw error;
+        }
+    } finally {
+        try { unlinkSync(tempPath); } catch { /* já removido */ }
+    }
+}
+
+function scanLedger(ledgerDir: string): {
+    reservedMicros: number;
+    chargedMicros: number;
+    corrupt: string[];
+} {
+    let reservedMicros = 0;
+    let chargedMicros = 0;
+    const corrupt: string[] = [];
+    let entries: string[];
+    try {
+        entries = readdirSync(ledgerDir);
+    } catch {
+        return { reservedMicros, chargedMicros, corrupt };
+    }
+    for (const name of entries) {
+        if (!name.startsWith('budget_') || !name.endsWith('.json') || name.includes('.tmp.')) continue;
+        const filePath = path.join(ledgerDir, name);
+        const parsed = readRecord(filePath);
+        if (!parsed.ok) {
+            corrupt.push(name);
+            continue;
+        }
+        // Quantia negativa/corrompida no campo: conta como zero aqui, mas o registro
+        // ilegível como um todo é o caso tratado acima. Estados ativos somam.
+        const amount = Number.isFinite(parsed.record.amountMicros)
+            ? Math.max(0, Math.round(parsed.record.amountMicros))
+            : 0;
+        if (parsed.record.state === 'RESERVED') reservedMicros += amount;
+        if (parsed.record.state === 'CHARGED') chargedMicros += amount;
+    }
+    return { reservedMicros, chargedMicros, corrupt };
+}
+
+// Poda best-effort de liberações antigas (auditoria 7 dias). Reservas e cobranças
+// NUNCA são podadas — são a prova de dinheiro comprometido.
+function pruneReleased(ledgerDir: string, nowMs: number): void {
+    let entries: string[];
+    try {
+        entries = readdirSync(ledgerDir);
+    } catch {
+        return;
+    }
+    for (const name of entries) {
+        if (!name.startsWith('budget_') || !name.endsWith('.json') || name.includes('.tmp.')) continue;
+        const filePath = path.join(ledgerDir, name);
+        const parsed = readRecord(filePath);
+        if (!parsed.ok || parsed.record.state !== 'RELEASED') continue;
+        const updatedAt = Date.parse(parsed.record.updatedAt);
+        if (Number.isFinite(updatedAt) && nowMs - updatedAt > RELEASED_RETENTION_MS) {
+            try { unlinkSync(filePath); } catch { /* poda best-effort */ }
+        }
+    }
+}
+
+export function reserveCost(params: {
+    ledgerDir: string;
+    operationKey: string;
+    amountMicros: number;
+    payloadHash: string;
+    jobId?: string;
+    sceneId?: string;
+    capMicros: number;
+    now?: number;
+}): ReserveOutcome {
+    const { ledgerDir, operationKey, payloadHash, capMicros } = params;
+    const amountMicros = Math.round(params.amountMicros);
+    if (!Number.isSafeInteger(amountMicros) || amountMicros <= 0) {
+        throw new Error(`cost-ledger: quantia inválida para reserva: ${params.amountMicros}`);
+    }
+    if (!operationKey || operationKey.length > 200) {
+        throw new Error('cost-ledger: operationKey inválida');
+    }
+    if (!/^[0-9a-f]{64}$/.test(payloadHash)) {
+        throw new Error('cost-ledger: payloadHash deve ser sha256 hexadecimal');
+    }
+    if (!Number.isSafeInteger(capMicros) || capMicros <= 0) {
+        throw new Error('cost-ledger: capMicros inválido');
+    }
+
+    mkdirSync(ledgerDir, { recursive: true });
+    const filePath = reservationPath(ledgerDir, operationKey);
+
+    if (existsSync(filePath)) {
+        return adoptExisting(filePath, operationKey, payloadHash);
+    }
+
+    pruneReleased(ledgerDir, params.now ?? Date.now());
+
+    const nowIso = new Date(params.now ?? Date.now()).toISOString();
+    const record: LedgerRecord = {
+        key: operationKey,
+        amountMicros,
+        payloadHash,
+        state: 'RESERVED',
+        jobId: params.jobId,
+        sceneId: params.sceneId,
+        createdAt: nowIso,
+        updatedAt: nowIso,
+    };
+
+    let won: boolean;
+    try {
+        won = createReservationAtomically(filePath, record);
+    } catch (error) {
+        throw new Error(`cost-ledger: falha ao gravar reserva ${operationKey}: ${error instanceof Error ? error.message : String(error)}`);
+    }
+    if (!won) {
+        return adoptExisting(filePath, operationKey, payloadHash);
+    }
+
+    // Reserva-então-verifica: o arquivo próprio JÁ está na soma — a checagem é
+    // `total (inclusive esta reserva) <= teto`. Quem chega depois enxerga as
+    // reservas anteriores e aborta; corridas podem rejeitar a mais (conservador),
+    // jamais gastar a mais. Janela de crash entre criar e verificar retém no
+    // máximo UMA reserva pendente (conservador, nunca silencia verba).
+    const scan = scanLedger(ledgerDir);
+    if (scan.corrupt.length) {
+        try { unlinkSync(filePath); } catch { /* retenção conservadora */ }
+        return { kind: 'ledger_corrupt', filePath: path.join(ledgerDir, scan.corrupt[0]) };
+    }
+    const committed = scan.reservedMicros + scan.chargedMicros;
+    if (committed > capMicros) {
+        try { unlinkSync(filePath); } catch {
+            // Rollback falhou: a reserva permanece retida (conservador) e o erro
+            // aponta o arquivo para intervenção manual.
+            throw new Error(`cost-ledger: rollback da reserva excedente falhou (${operationKey}) — verifique ${filePath}`);
+        }
+        return {
+            kind: 'budget_exceeded',
+            requestedMicros: amountMicros,
+            committedMicros: committed,
+            capMicros,
+        };
+    }
+    return { kind: 'reserved', reservation: { operationKey, filePath, amountMicros } };
+}
+
+function adoptExisting(filePath: string, operationKey: string, payloadHash: string): ReserveOutcome {
+    const parsed = readRecord(filePath);
+    if (!parsed.ok) return { kind: 'ledger_corrupt', filePath };
+    const existing = parsed.record;
+    if (existing.key !== operationKey) return { kind: 'ledger_corrupt', filePath };
+    if (existing.payloadHash !== payloadHash) {
+        return { kind: 'conflict', reason: 'PAYLOAD_MISMATCH' };
+    }
+    if (existing.state === 'RELEASED') {
+        // Retomada após falha confirmada exige NOVA chave de tentativa (nova reserva).
+        return { kind: 'conflict', reason: 'KEY_RELEASED_USE_NEW_ATTEMPT' };
+    }
+    return {
+        kind: 'existing',
+        reservation: { operationKey, filePath, amountMicros: existing.amountMicros },
+    };
+}
+
+// Cobrança confirmada (geração concluída): fica retida para sempre no teto.
+export function chargeCost(params: {
+    ledgerDir: string;
+    operationKey: string;
+    now?: number;
+}): ChargeOutcome {
+    const filePath = reservationPath(params.ledgerDir, params.operationKey);
+    const parsed = readRecord(filePath);
+    if (!parsed.ok) return { kind: 'unknown_key' };
+    if (parsed.record.state === 'CHARGED') return { kind: 'already_charged' };
+    if (parsed.record.state !== 'RESERVED') {
+        return { kind: 'conflict', state: parsed.record.state };
+    }
+    writeRecordAtomic(filePath, {
+        ...parsed.record,
+        state: 'CHARGED',
+        updatedAt: new Date(params.now ?? Date.now()).toISOString(),
+    });
+    return { kind: 'charged' };
+}
+
+export function releaseCost(params: {
+    ledgerDir: string;
+    operationKey: string;
+    reason: ReleaseReason;
+    now?: number;
+}): ReleaseOutcome {
+    if (!RELEASE_REASONS.includes(params.reason)) {
+        throw new Error(`cost-ledger: motivo de liberação não documentado: ${params.reason}`);
+    }
+    const filePath = reservationPath(params.ledgerDir, params.operationKey);
+    const parsed = readRecord(filePath);
+    if (!parsed.ok) return { kind: 'unknown_key' };
+    if (parsed.record.state === 'RELEASED') return { kind: 'already_released' };
+    if (parsed.record.state === 'CHARGED') return { kind: 'charged_cannot_release' };
+    if (parsed.record.state !== 'RESERVED') {
+        return { kind: 'conflict', state: parsed.record.state };
+    }
+    writeRecordAtomic(filePath, {
+        ...parsed.record,
+        state: 'RELEASED',
+        releaseReason: params.reason,
+        updatedAt: new Date(params.now ?? Date.now()).toISOString(),
+    });
+    return { kind: 'released' };
+}
+
+export function readBudgetSummary(ledgerDir: string, capMicros: number): BudgetSummary {
+    const scan = scanLedger(ledgerDir);
+    const committed = scan.reservedMicros + scan.chargedMicros;
+    return {
+        capMicros,
+        reservedMicros: scan.reservedMicros,
+        chargedMicros: scan.chargedMicros,
+        remainingMicros: Math.max(0, capMicros - committed),
+        corruptEntries: scan.corrupt,
+    };
+}
+
+// Teto dos testes iniciais: US$30 acumulados por padrão (decisão do Felipe,
+// 08/11/2026). Override documentado por ambiente; inválido é erro explícito.
+export function budgetCapMicrosFromEnv(env: Record<string, string | undefined> = process.env): number {
+    const raw = (env.HIGGSFIELD_INITIAL_TEST_CAP_USD ?? '').trim();
+    if (raw === '') return 30 * MICRO_PER_USD;
+    const micros = parseUsdToMicros(raw);
+    if (micros === null || micros <= 0) {
+        throw new Error(`HIGGSFIELD_INITIAL_TEST_CAP_USD inválido: "${raw.slice(0, 64)}" (use USD decimal, ex.: 30 ou 30.00)`);
+    }
+    return micros;
+}
