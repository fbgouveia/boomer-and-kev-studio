+
+    it('completed sem video.url utilizável => unknown (nunca inventar saída)', async () => {
+        const { impl } = mockFetch(() => jsonResponse({ status: 'completed' }));
+        const client = new HiggsfieldClient({ apiKey: API_KEY, fetchImpl: impl });
